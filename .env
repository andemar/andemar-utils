# Host Workspace Root Path
# On Linux / macOS:
#   HOST_WORKSPACE_DIR=$(pwd)
# On Windows PowerShell:
#   HOST_WORKSPACE_DIR=${PWD}
#   (or explicit absolute path, e.g. F:\Dev\repos\andemar-utils)
HOST_WORKSPACE_DIR=D:\Descargas\utils

# Port Configuration
HUB_UI_PORT=80
HUB_BACKEND_PORT=4000

# Docker Socket Path
# Linux / macOS standard: /var/run/docker.sock
# Windows Docker Desktop (native named pipe): //./pipe/docker_engine
DOCKER_SOCKET=/var/run/docker.sock

# Docker Internal Bridge Network Name
DOCKER_NETWORK=hub-network

